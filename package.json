{
  "name": "waifu-deck",
  "main": "expo-router/entry",
  "version": "1.2.1",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/ui": "~56.0.26",
    "@noble/hashes": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native-segmented-control/segmented-control": "2.5.7",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.101.2",
    "cockatiel": "^3.2.1",
    "expo": "~56.0.21",
    "expo-background-task": "~56.0.27",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.18",
    "expo-crypto": "~56.0.5",
    "expo-dev-client": "~56.0.26",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-glass-effect": "~56.0.4",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.12",
    "expo-image-manipulator": "~56.0.26",
    "expo-image-picker": "~56.0.25",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.17",
    "expo-localization": "~56.0.6",
    "expo-media-library": "~56.0.11",
    "expo-network": "~56.0.5",
    "expo-router": "~56.2.20",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.26",
    "expo-splash-screen": "~56.0.15",
    "expo-sqlite": "~56.0.6",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.7",
    "expo-system-ui": "~56.0.5",
    "expo-task-manager": "~56.0.27",
    "expo-web-browser": "~56.0.6",
    "i18next": "^26.3.6",
    "lucide-react-native": "^1.25.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.10",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.2",
    "@xmldom/xmldom": "^0.9.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.5",
    "patch-package": "^8.0.1",
    "sharp": "^0.35.3",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "android": "expo prebuild --platform android --clean && expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "test": "jest",
    "test:audit": "node --test scripts/*.test.mjs scripts/content-quality/*.test.mjs plugins/*.test.mjs modules/*/*.test.mjs",
    "test:coverage": "jest --coverage --runInBand",
    "audit:content": "node scripts/audit-content-quality.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test -- --maxWorkers=2 --workerIdleMemoryLimit=768MB && npm run test:audit",
    "postinstall": "patch-package",
    "web": "expo start --web",
    "verify:byos-minio": "node scripts/run-byos-minio-gate.mjs",
    "verify:byos-r2": "node scripts/run-byos-r2-gate.mjs",
    "verify:byos-wasabi": "node scripts/run-byos-wasabi-gate.mjs",
    "verify:byos-bunny": "node scripts/run-byos-bunny-gate.mjs",
    "verify:byos-webdav": "node scripts/run-byos-webdav-gate.mjs",
    "verify:byos-onedrive": "node scripts/run-byos-onedrive-gate.mjs",
    "verify:byos-gdrive": "node scripts/run-byos-gdrive-gate.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@noble/hashes))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/cloudflare/vault/",
      "<rootDir>/cloudflare/e2e-fixtures/",
      "<rootDir>/src/integration/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/app/**",
      "!**/*.d.ts"
    ]
  },
  "private": true
}
