{
  "expo": {
    "owner": "dirtyfancys-team",
    "name": "Waifu Deck",
    "slug": "waifu-deck",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/images/waifu-deck-icon.png",
    "scheme": ["waifudeck", "com.googleusercontent.apps.550668815694-769sb0u8q37u6cc8ha4pb00bjs6808ec"],
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/waifu-deck-icon.png",
      "bundleIdentifier": "app.waifudeck.mobile"
    },
    "android": {
      "package": "app.waifudeck.mobile",
      "versionCode": 1002001,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F7F8F6",
        "foregroundImage": "./assets/images/waifu-deck-adaptive-foreground.png",
        "monochromeImage": "./assets/images/waifu-deck-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/waifu-deck-favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8F6",
          "image": "./assets/images/waifu-deck-splash.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "android": ["en", "zh-Hans", "zh-Hant", "ja"],
            "ios": ["en", "zh-Hans", "zh-Hant", "ja"]
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "af306e98-4393-4150-9902-6c4cfc9aebd5"
      }
    }
  }
}
